# Copy to .env and fill in.
#
# This file is read by server/proxy.mjs ONLY. The key stays in that node process:
# it is never bundled, never sent to the browser, and never returned by /api/llm.
#
# Any OpenAI-compatible endpoint works — the defaults below target DeepSeek.
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
PORT=8787
