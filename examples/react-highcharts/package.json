{
  "name": "example-react-highcharts",
  "private": true,
  "version": "0.0.0",
  "description": "How to use chartwright from a React app with Highcharts.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env server/proxy.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:proxy": "node --test server/proxy.test.mjs",
    "gen:data": "node scripts/generate-data.mjs"
  },
  "dependencies": {
    "chartwright": "*",
    "highcharts": "^12.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
