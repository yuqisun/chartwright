{
  "name": "chartwright-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Natural-language charts in your own process: an agentic loop inspects your data locally, a deterministic compiler emits chart-library options.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace examples/react-highcharts",
    "build": "npm run build --workspace examples/react-highcharts",
    "gen:data": "node examples/react-highcharts/scripts/generate-data.mjs",
    "verify": "npm run typecheck --workspace chartwright && npm run typecheck:example && node scripts/verify-tests.mjs && npm run showcase -- --check",
    "typecheck:example": "tsc --noEmit -p examples/react-highcharts/tsconfig.json",
    "showcase": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-showcase.ts",
    "render": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-matrix.ts",
    "gallery": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-gallery.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
